# 复制本文件为 .env 后按需修改：cp .env.example .env
# .env 不入库。环境变量（CARDET_*）优先级高于 .env，便于 CI / 生产覆盖。
# 所有相对路径都以项目根目录为基准，也可以直接写绝对路径。

# ---------------------------------------------------------------- 模型与数据
# 推理权重：训练完成后把 runs/train/exp/weights/best.pt 复制到这里
CARDET_WEIGHTS=models/best.pt
# 训练用数据集描述文件（从 configs/data.example.yaml 复制而来）
CARDET_DATA_YAML=configs/data.yaml
# 模型结构定义（一般不用改，直接用 vendor 中的官方 yaml）
CARDET_MODEL_CFG=yolov5/models/yolov5s.yaml
# 迁移学习预训练权重
CARDET_PRETRAINED=models/yolov5s.pt

# ---------------------------------------------------------------- 推理 / 训练参数
# 留空 = 自动（有 CUDA 用 GPU 0，否则 CPU）；可填 cpu / 0 / 0,1 / mps
CARDET_DEVICE=
CARDET_IMGSZ=640
CARDET_CONF_THRES=0.25
CARDET_IOU_THRES=0.45
CARDET_EPOCHS=100
CARDET_BATCH_SIZE=16
CARDET_TRAIN_NAME=exp

# ---------------------------------------------------------------- 运行态目录
CARDET_DATA_DIR=data
CARDET_INPUT_DIR=input
CARDET_OUTPUT_DIR=output
CARDET_RUNS_DIR=runs

# ---------------------------------------------------------------- Web（cloudtest.py）
# 生产环境必须显式设置随机密钥；留空则每次启动生成一次性随机值
CARDET_SECRET_KEY=
CARDET_HOST=127.0.0.1
CARDET_PORT=5000
# 仅本地开发可设为 1，生产环境务必保持 0
CARDET_DEBUG=0
# 上传大小上限（字节），默认 16MB；要上传大视频请调大
CARDET_MAX_CONTENT_LENGTH=16777216
